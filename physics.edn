;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a document-handling and scheduling robot performs
;; staff scheduling, resident enrollment, family outreach and incident logging
;; for aged care services managers (ISCO 1343). Its physical work is the
;; paper side of that: carrying enrollment files, family mail and incident
;; log binders from the office to the ward stations along corridors shared
;; with residents, and filing resident record boxes into the locked cabinet.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-1343"
 :cases
 [{:id :ward-file-round
   :kind :transport
   :procedure "robot carries enrollment files, family mail and incident log binders 90 m from the office to the ward station at resident walking pace"
   :params {:mass-kg 35.0 :distance-m 90.0 :v-max-mps 0.6 :a-max-mps2 0.3
            :brake-decel-mps2 0.5 :drive-force-n 45.0 :crr 0.02
            :cog-height-m 0.45 :support-half-length-m 0.25}
   :sweep {:param :payload-kg :values [3.0 10.0 25.0 50.0 80.0]}
   :quantity :cycle-time-s
   :limit {:max 165.0 :basis "estimate: a ward round of paperwork inside the ~3-minute gap the station staff set aside at handover"}
   :boundary {:lo 1.0 :hi 250.0}}
  {:id :record-box-into-cabinet
   :kind :manipulator
   :procedure "arm files a resident record box from the cart into the locked records cabinet; move time swept"
   :params {:l1-m 0.50 :l2-m 0.45 :m1-kg 4.5 :m2-kg 3.2 :payload-kg 4.0
            :from [0.55 0.05] :to [0.40 0.65] :steps 400}
   :sweep {:param :duration-s :values [0.6 0.9 1.2 1.8 2.5]}
   :quantity :peak-tau1-nm
   :limit {:max 70.0 :basis "estimate: continuous shoulder torque of a ~7 kg-payload collaborative arm"}
   :boundary {:lo 0.3 :hi 4.0}}]}
